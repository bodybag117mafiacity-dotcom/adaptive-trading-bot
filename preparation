class MathEngine:
    def multiplier(self, buy_price, sell_price):
        if buy_price == 0:
            return 0
        return sell_price / buy_price

    def position_size(self, capital, risk_factor):
        """
        Calculate position size based on capital and risk.
        """
        return capital * risk_factor
